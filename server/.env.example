# Токен бота из @BotFather. Тот же самый, на который настроена кнопка меню.
# Без него сервер не может проверить, что запрос действительно пришёл из
# Telegram, а не от кого-то, кто просто подделал данные.
BOT_TOKEN=

# Порт, на котором слушает сервер. Хостинг обычно сам подставляет свой —
# тогда переменная PORT придёт от него и эта строка не понадобится.
PORT=3000

# Адрес фронтенда, которому разрешено обращаться к серверу (CORS).
# На проде — это ссылка на Vercel, например https://habora-app.vercel.app.
# * означает «разрешить всем» — годится только для локальной разработки.
ALLOWED_ORIGIN=*

# Где на диске лежит файл базы данных — используется только для локальной
# разработки (пока не заданы переменные TURSO_* ниже).
DB_PATH=./data/habora.db

# Адрес облачной базы Turso и токен доступа к ней. Получаются на turso.tech —
# бесплатно, данные там не пропадают при перезапуске сервера. Если оставить
# пустыми, сервер локально работает с обычным файлом на диске (см. DB_PATH).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Публичный адрес самого сервера. По нему Telegram присылает сообщения,
# написанные боту. На Render подставляется автоматически (RENDER_EXTERNAL_URL),
# задавать вручную нужно только на другом хостинге.
PUBLIC_URL=

# Адрес мини-приложения для кнопки «Открыть приложение» в сообщениях бота.
# Если не задан, берётся ALLOWED_ORIGIN — обычно это то же самое.
WEBAPP_URL=

# Час, когда приходит вечернее напоминание, по местному времени человека.
# По умолчанию 19.
REMINDER_HOUR=
